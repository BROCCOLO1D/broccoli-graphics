{
  "name": "broccoli-graphics",
  "version": "0.0.0",
  "description": "High-performance TypeScript graphics toolkit for dithering, ASCII art, and animation",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./luminance": {
      "types": "./dist/luminance.d.ts",
      "import": "./dist/luminance.js",
      "require": "./dist/luminance.cjs"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js",
      "require": "./dist/palette.cjs"
    },
    "./dither/ordered": {
      "types": "./dist/dither/ordered.d.ts",
      "import": "./dist/dither/ordered.js",
      "require": "./dist/dither/ordered.cjs"
    },
    "./dither/error-diffusion": {
      "types": "./dist/dither/error-diffusion.d.ts",
      "import": "./dist/dither/error-diffusion.js",
      "require": "./dist/dither/error-diffusion.cjs"
    },
    "./ascii/charset": {
      "types": "./dist/ascii/charset.d.ts",
      "import": "./dist/ascii/charset.js",
      "require": "./dist/ascii/charset.cjs"
    },
    "./ascii/convert": {
      "types": "./dist/ascii/convert.d.ts",
      "import": "./dist/ascii/convert.js",
      "require": "./dist/ascii/convert.cjs"
    },
    "./render/text": {
      "types": "./dist/render/text.d.ts",
      "import": "./dist/render/text.js",
      "require": "./dist/render/text.cjs"
    },
    "./render/svg": {
      "types": "./dist/render/svg.d.ts",
      "import": "./dist/render/svg.js",
      "require": "./dist/render/svg.cjs"
    },
    "./animation/frames": {
      "types": "./dist/animation/frames.d.ts",
      "import": "./dist/animation/frames.js",
      "require": "./dist/animation/frames.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples/input",
    "examples/output"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "build": "tsup src/index.ts src/types.ts src/luminance.ts src/palette.ts src/dither/ordered.ts src/dither/error-diffusion.ts src/ascii/charset.ts src/ascii/convert.ts src/render/text.ts src/render/svg.ts src/animation/frames.ts --format esm,cjs --dts --sourcemap",
    "dev": "tsx examples/basic.ts",
    "lint": "tsc --noEmit",
    "examples": "tsx scripts/generate-examples.ts",
    "verify:examples": "node scripts/verify-examples.mjs",
    "verify:exports": "node scripts/verify-package-exports.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BROCCOLO1D/broccoli-graphics.git"
  },
  "keywords": [
    "ascii-art",
    "dithering",
    "floyd-steinberg",
    "graphics",
    "image-processing",
    "ordered-dithering",
    "typescript"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BROCCOLO1D/broccoli-graphics/issues"
  },
  "homepage": "https://github.com/BROCCOLO1D/broccoli-graphics#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "gifenc": "^1.0.3",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
